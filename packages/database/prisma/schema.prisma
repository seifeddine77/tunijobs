datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum ContractType {
  CDI
  CDD
  SIVP
  KARAMA
  STAGE
  FREELANCE
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum OfferStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  CLOSED
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  RECEIVED
  SCREENED
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String?
  role            UserRole          @default(CANDIDATE)
  isEmailVerified Boolean           @default(false)
  phone           String?
  googleId        String?           @unique
  consentGdprAt   DateTime?
  candidate       CandidateProfile?
  company         Company?
  auditLogs       AuditLog[]
  notifications   Notification[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email])
}

model CandidateProfile {
  id                    String           @id @default(uuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  headline              String?
  bio                   String?
  experienceYears       Int              @default(0)
  currentSalary         Int?
  expectedSalary        Int?
  currency              String           @default("TND")
  preferredGovernorates String[]
  cvFileUrl             String?
  cvParsedText          String?          @db.Text
  rawCvJson             Json?
  skills                CandidateSkill[]
  educations            Education[]
  experiences           Experience[]
  applications          Application[]
  savedJobs             SavedJob[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Company {
  id          String        @id @default(uuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  taxId       String        @unique
  sector      String
  size        String
  logoUrl     String?
  website     String?
  description String        @db.Text
  status      CompanyStatus @default(PENDING)
  offers      JobOffer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model JobOffer {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  slug            String        @unique
  description     String        @db.Text
  requirements    String        @db.Text
  contractType    ContractType
  workMode        WorkMode      @default(ON_SITE)
  experienceLevel String        @default("Confirmé")
  salaryMin       Int?
  salaryMax       Int?
  currency        String        @default("TND")
  status          OfferStatus   @default(DRAFT)
  governorateCode String
  governorate     Governorate   @relation(fields: [governorateCode], references: [code])
  delegation      String?
  latitude        Float
  longitude       Float
  skills          JobSkill[]
  applications    Application[]
  savedBy         SavedJob[]
  viewsCount      Int           @default(0)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([governorateCode, status])
  @@index([contractType, workMode])
}

model Skill {
  id         String           @id @default(uuid())
  name       String           @unique
  category   String?
  escoUri    String?
  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level       String?

  @@unique([candidateId, skillId])
}

model JobSkill {
  id          String   @id @default(uuid())
  jobOfferId  String
  jobOffer    JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isMandatory Boolean  @default(true)

  @@unique([jobOfferId, skillId])
}

model Application {
  id            String            @id @default(uuid())
  candidateId   String
  candidate     CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOfferId    String
  jobOffer      JobOffer          @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(RECEIVED)
  aiScore       Float?
  aiStrengths   Json?
  aiMissing     Json?
  aiExplanation String?           @db.Text
  coverLetter   String?           @db.Text
  notes         ApplicationNote[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([candidateId, jobOfferId])
  @@index([jobOfferId, status])
}

model ApplicationNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  content       String      @db.Text
  createdAt     DateTime    @default(now())
}

model Governorate {
  code      String     @id
  nameFr    String
  nameAr    String
  nameEn    String
  centerLat Float
  centerLng Float
  offers    JobOffer[]
}

model Education {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startDate   DateTime
  endDate     DateTime?
}

model Experience {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyName String
  roleTitle   String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?          @db.Text
}

model SavedJob {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOfferId  String
  jobOffer    JobOffer         @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([candidateId, jobOfferId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
