# ---------------------------------------------
# TUNIJOBS ENVIRONMENT CONFIGURATION
# ---------------------------------------------

# PostgreSQL with PostGIS & pgvector
DB_USER=tunijobs
DB_PASSWORD=tunijobs_secret
DB_NAME=tunijobs_db
DB_PORT=5434
DATABASE_URL="postgresql://tunijobs:tunijobs_secret@localhost:5434/tunijobs_db?schema=public"

# Redis & BullMQ
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL="redis://localhost:6379"

# MinIO (S3 Compatible Storage)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET_CV="tunijobs-cv"
MINIO_BUCKET_LOGOS="tunijobs-logos"

# NestJS API
PORT=4000
JWT_SECRET=super_secret_jwt_tunijobs_key_change_in_production_2026
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super_secret_refresh_tunijobs_key_change_in_production_2026
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (Optional in local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Microservice IA (FastAPI)
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY=""

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
